      "position": [
        940,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://rag-service.dev.svc.cluster.local/query",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ question: $json.input, top_k: 5 }) }}",
        "options": {}
      },
      "id": "n5",
      "name": "Call rag-service /query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,

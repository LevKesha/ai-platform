        1180,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://claude-router.dev.svc.cluster.local/route",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ task: 'classify_route', allowed_modes: ['rag', 'agent'], input: $json.input }) }}",
        "options": {}
      },

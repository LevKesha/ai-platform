        "jsCode": "const b = $json.body ?? $json;\nconst mode = String(b.mode ?? '').toLowerCase();\nconst input = String(b.input ?? '').trim();\nconst allowed = ['rag','agent','auto'];\nif (!allowed.includes(mode)) {\n  return [{ json: { validationFailed: true, error: `mode must be one of: ${allowed.join(', ')}` } }];\n}\nif (!input) {\n  return [{ json: { validationFailed: true, error: 'input is required' } }];\n}\nif (input.length > 8000) {\n  return [{ json: { validationFailed: true, error: 'input too long (max 8000 chars)' } }];\n}\nreturn [{ json: { mode, input, validationFailed: false } }];"
      },

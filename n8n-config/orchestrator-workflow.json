      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const b = $json.body ?? $json;\nconst mode = String(b.mode ?? '').toLowerCase();\nconst input = String(b.input ?? '').trim();\nconst allowed = ['rag','agent','auto'];\nif (!allowed.includes(mode)) {\n  throw new Error(`mode must be one of: ${allowed.join(', ')}`);\n}\nif (!input) {\n  throw new Error('input is required');\n}\nif (input.length > 8000) {\n  throw new Error('input too long (max 8000 chars)');\n}\nreturn [{ json: { mode, input } }];"
      },
      "id": "n2",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "combineOperation": "all",
        "conditions": {
          "string": [
            {
              "value1": "={{$json.mode}}",
              "operation": "equal",
              "value2": "rag"
            }
          ]
        }
      },
      "id": "n3",
      "name": "IF Mode = rag",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        700,
        300
      ]
